# =============================================================================
#  Unstitch - backend configuration
# =============================================================================
#  Copy this file to `.env` and fill in the ONE required secret below.
#  `.env` is gitignored; this `.env.example` is committed and must never
#  contain a real key.
#
#      cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
#  1. GEMINI_API_KEY   <-- THE ONLY SECRET YOU MUST PROVIDE
# -----------------------------------------------------------------------------
#  Powers the vision layer: reads on-screen text and returns bounding boxes,
#  classifying each element as caption / text overlay / product pop-up /
#  watermark / UI chrome.
#
#  How to get it (free, no credit card):
#    1. Open  https://aistudio.google.com/apikey
#    2. Sign in with any Google account
#    3. Click "Create API key"  ->  "Create API key in new project"
#    4. Copy the value (starts with "AIza...") and paste it below
#
#  Free tier on gemini-2.5-flash: ~10 requests/min, ~250 requests/day.
#  Unstitch uses ~4 requests per video, so roughly 60 de-edits per day.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Vision model. gemini-2.5-flash is the cheapest model with a free tier that
# supports both image input and structured JSON output.
# Do NOT switch to gemini-2.0-flash: its free generation quota is 0.
GEMINI_MODEL=gemini-2.5-flash

# gemini | stub
#   gemini -> real vision analysis (needs GEMINI_API_KEY above)
#   stub   -> offline heuristic detector; lets the whole pipeline run with no
#             key at all. Useful for local development and if quota runs out.
VISION_PROVIDER=gemini


# -----------------------------------------------------------------------------
#  2. OPTIONAL - only if downloading from Instagram / TikTok hits a login wall
# -----------------------------------------------------------------------------
#  Leave BLANK for now. YouTube Shorts URLs and direct file upload both work
#  without it. If a URL fails with an auth error, export cookies.txt using a
#  browser extension ("Get cookies.txt LOCALLY") and put the file path here.
# -----------------------------------------------------------------------------
YTDLP_COOKIES_FILE=


# =============================================================================
#  Everything below is tuning, not secrets. The defaults work - adjust only if
#  you want to trade speed against accuracy.
# =============================================================================

# --- Ingest -------------------------------------------------------------------
MAX_UPLOAD_MB=100
# Videos longer than this are rejected. Keeps free-tier processing time sane.
MAX_VIDEO_SECONDS=90
# Downscale height before processing. 720 is plenty for detection and roughly
# 4x faster to encode than 1080.
TARGET_HEIGHT=720

# --- Scene detection ----------------------------------------------------------
# PySceneDetect ContentDetector sensitivity. Lower = more cuts detected.
# 27.0 is the library default and works well for fast-cut UGC ads.
SCENE_THRESHOLD=27.0
# Ignore detected scenes shorter than this (usually flash-frames, not real cuts)
MIN_SCENE_SECONDS=0.6

# --- Frame sampling (this is what controls your API usage) --------------------
FRAME_SAMPLE_INTERVAL_S=1.5
MAX_FRAMES=24
VISION_BATCH_SIZE=6

# --- Overlay tracking ---------------------------------------------------------
# How much two boxes in different frames must overlap to count as the same
# element. Raise for stricter matching, lower if one overlay splits into many.
TRACK_IOU_THRESHOLD=0.5
# An overlay may vanish for this long and still be treated as one continuous
# track. This MUST exceed 2 x FRAME_SAMPLE_INTERVAL_S, because a single missed
# detection leaves a gap of two intervals (1.5 -> 3.0s) - a smaller tolerance
# would split the very case it exists to absorb.
TRACK_MAX_GAP_S=3.5
# Drop detections the model was unsure about.
MIN_DETECTION_CONFIDENCE=0.35

# --- Removal ------------------------------------------------------------------
# delogo  | fast, interpolates from the mask border, best over busy footage
# boxblur | never invents detail; the honest "this was covered" look
#
# OpenCV inpainting was deliberately not implemented: it needs a per-frame
# Python loop (~2 min for a 90s clip) and cannot share the single render
# pass the other two modes use. See the README.
REMOVAL_MODE=delogo
# Grow each mask by this % of frame size. Compensates for bounding-box jitter
# so anti-aliased text edges do not survive the removal.
MASK_PADDING_PCT=2.0

# --- Runtime ------------------------------------------------------------------
MEDIA_ROOT=./work
JOB_TTL_MINUTES=120
MAX_CONCURRENT_JOBS=2
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

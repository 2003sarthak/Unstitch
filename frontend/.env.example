# =============================================================================
#  Unstitch - frontend configuration
# =============================================================================
#  Copy to `.env` :   cp .env.example .env
#  No secrets here. Anything prefixed VITE_ is baked into the browser bundle
#  and is publicly readable, so NEVER put an API key in this file.
# =============================================================================

# Where the FastAPI backend lives.
#   local dev  -> http://localhost:8000
#   production -> https://<your-hf-username>-unstitch.hf.space
VITE_API_BASE_URL=http://localhost:8000
